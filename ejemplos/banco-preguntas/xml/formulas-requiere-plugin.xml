        <text></text>
      </otherrule>
      <subqtext format="html">
        <text><![CDATA[<p>2. Si uno de los prisioneros es liberado, ¿cuántas imágenes seguirían viendo los que permanecen encadenados?</p>]]></text>
      </subqtext>
      <feedback format="html">
        <text><![CDATA[<p>Correcto: restantes = (prisioneros - 1) × sombras.</p>]]></text>
      </feedback>
    </answers>
  </question>
