      <numbox>
        <text>1</text>
      </numbox>
      <vars1>
        <text></text>
      </vars1>
      <answer>
        <text>restantes</text>
      </answer>
      <vars2>
        <text></text>
      </vars2>
      <correctness>
        <text><![CDATA[_relerr < 0.001]]></text>
      </correctness>
